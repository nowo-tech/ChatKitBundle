###> symfony/framework-bundle ###
# APP_ENV: Symfony environment of the demo — `dev` (debug toolbar, hot reload) or `prod`.
APP_ENV=dev
# APP_SECRET: secret for CSRF tokens and signed URLs. Demo-only value: never reuse it in a real application.
APP_SECRET=change_this_secret_key_to_a_random_value
# APP_DEBUG: 1 shows errors and the WebProfiler; 0 behaves like production.
APP_DEBUG=1

# FRANKENPHP_MODE: FrankenPHP runtime mode — `classic` (one process per request) or `worker` (long-lived workers).
# Default: worker. Set classic for per-request PHP / easier hot-reload. Recreate with `docker compose up -d` after change.
FRANKENPHP_MODE=worker
###< symfony/framework-bundle ###

# PORT: host port of the demo (http://localhost:PORT). Change it when 8147 is taken.
PORT=8147

###> symfony/routing ###
# DEFAULT_URI: base URL for links generated outside a request (console, Messenger). Keep it in step with PORT.
DEFAULT_URI=http://localhost:8147
###< symfony/routing ###

###> doctrine/doctrine-bundle ###
# DATABASE_URL: the demo's MySQL container (service `db`, not exposed on the host).
DATABASE_URL="mysql://app:app@db:3306/app?serverVersion=8.0.0&charset=utf8mb4"
###< doctrine/doctrine-bundle ###
