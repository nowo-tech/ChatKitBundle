{# ChatKit 2.6: the selection arrives in the browser (`nowo-chat:slot-payload`), never in the URL. #}
<label for="demo-vault-value">{{ 'demo.cards.value'|trans }}</label>
<textarea id="demo-vault-value" class="nowo-ui-input" rows="3" data-demo-selection data-testid="demo-vault-value"></textarea>
<p><button type="button" class="nowo-ui-btn nowo-ui-btn--primary" data-demo-close>{{ 'demo.cards.save'|trans }}</button></p>
