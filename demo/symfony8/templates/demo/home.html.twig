{#- Demo home, in the demo platform layout grammar: page header (title, lead, the one primary action), then one
    section card per topic (demo_platform/_section.html.twig). -#}
{% extends 'base.html.twig' %}

{% block nowo_ui_page_header %}
    {% set _toolbar %}{% if app.user %}<a class="nowo-ui-btn nowo-ui-btn--primary" href="{{ path('nowo_chat_page') }}">{{ 'demo.try.page'|trans }}</a>{% else %}<a class="nowo-ui-btn nowo-ui-btn--primary" href="{{ path('demo_login', {_locale: app.request.locale}) }}">{{ 'demo.login.nav'|trans }}</a>{% endif %}{% endset %}
    {{ include(nowo_ui_partial('page_header'), {title: 'demo.heading'|trans, intro: 'demo.lead'|trans ~ ' ' ~ 'demo.body'|trans({'%profile%': default_profile}), toolbar: _toolbar}) }}
{% endblock %}

{% block body %}
    <div class="nowo-ui-cards">
        {% embed '@NowoUiKit/demo_platform/_section.html.twig' with {title: 'demo.features.title'|trans, kind: 'list', attr: {'data-screenshot-target': ''}} %}
            {% block section_body %}
                <ul class="nowo-ui-list">
                    {% for key in ['dms', 'channels', 'support', 'realtime', 'presence', 'buzz', 'page', 'theming'] %}
                        <li class="nowo-ui-list-item">{{ ('demo.features.' ~ key)|trans }}</li>
                    {% endfor %}
                </ul>
            {% endblock %}
        {% endembed %}
        {% embed '@NowoUiKit/demo_platform/_section.html.twig' with {title: 'demo.try.title'|trans, kind: 'detail'} %}
            {% block section_body %}
                <p>{{ (app.user ? 'demo.try.signed_in' : 'demo.try.guest')|trans }}</p>
            {% endblock %}
            {% block section_footer %}
                {% if app.user %}
                    <a class="nowo-ui-btn nowo-ui-btn--outline" href="#" data-nowo-chat-open="support">{{ 'demo.try.support'|trans }}</a>
                {% endif %}
            {% endblock %}
        {% endembed %}
    </div>
{% endblock %}
