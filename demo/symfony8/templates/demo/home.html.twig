{% extends 'base.html.twig' %}

{% block nowo_ui_page_header %}
    {{ include(nowo_ui_partial('page_header'), { title: 'demo.heading'|trans }) }}
{% endblock %}

{% block body %}
<p>{{ 'demo.lead'|trans }}</p>
<p class="nowo-ui-muted">{{ 'demo.body'|trans({ '%profile%': default_profile }) }}</p>

<div class="nowo-ui-cards">
    <section class="nowo-ui-card" data-screenshot-target>
        <div class="nowo-ui-card__header"><h2 class="nowo-ui-card__title">{{ 'demo.features.title'|trans }}</h2></div>
        <div class="nowo-ui-card__body">
            <ul>
                {% for key in ['dms', 'channels', 'support', 'realtime', 'presence', 'buzz', 'page', 'theming'] %}
                    <li>{{ ('demo.features.' ~ key)|trans }}</li>
                {% endfor %}
            </ul>
        </div>
    </section>
    <section class="nowo-ui-card">
        <div class="nowo-ui-card__header"><h2 class="nowo-ui-card__title">{{ 'demo.try.title'|trans }}</h2></div>
        <div class="nowo-ui-card__body">
            {% if app.user %}
                <p>{{ 'demo.try.signed_in'|trans }}</p>
                <div class="nowo-ui-card__toolbar">
                    <a class="nowo-ui-btn nowo-ui-btn--outline" href="{{ path('nowo_chat_page') }}">{{ 'demo.try.page'|trans }}</a>
                    <a class="nowo-ui-btn nowo-ui-btn--outline" href="#" data-nowo-chat-open="support">{{ 'demo.try.support'|trans }}</a>
                </div>
            {% else %}
                <p>{{ 'demo.try.guest'|trans }}</p>
                <a class="nowo-ui-btn nowo-ui-btn--primary" href="{{ path('demo_login', { _locale: app.request.locale }) }}">{{ 'demo.login.nav'|trans }}</a>
            {% endif %}
        </div>
    </section>
</div>
{% endblock %}
