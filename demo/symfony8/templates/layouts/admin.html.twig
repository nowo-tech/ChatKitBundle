{#
  Demo host layout on the UiKit contract (nowo_ui_kit.layouts.admin): UiKit document + admin regions, the demo navbar
  in nowo_ui_navigation, UiKit default theme (REQ-DEMO-014: no CSS framework, no CDN), Vite entry of the demo, the chat dock in nowo_ui_modals.
  The full-page chat (/chat/) renders here with web_ui.layout_template left null.
#}
{% extends '@NowoUiKit/layout/admin.html.twig' %}

{% block nowo_ui_styles %}
    {{ parent() }}
    {{ vite_entry_link_tags('app') }}
{% endblock %}

{% block nowo_ui_navigation %}
    {% set _route = app.request.attributes.get('_route') %}
    {% set locale_route = _route starts with 'nowo_chat_' ? 'homepage' : _route %}
    {% set locale_params = locale_route == 'homepage' ? {} : app.request.attributes.get('_route_params')|default({}) %}
    <header class="nowo-ui-header" data-testid="demo-masthead">
        <a class="nowo-ui-brand" href="{{ path('homepage', { _locale: app.request.locale }) }}">{{ 'demo.brand'|trans }}</a>
        <nav class="nowo-ui-menu" aria-label="{{ 'demo.brand'|trans }}">
            <a class="nowo-ui-link" href="{{ path('homepage', { _locale: app.request.locale }) }}"{% if _route == 'homepage' %} aria-current="page"{% endif %}>{{ 'demo.nav.home'|trans }}</a>
            {% if app.user %}
                <a class="nowo-ui-link" href="{{ path('nowo_chat_page') }}"{% if _route starts with 'nowo_chat_page' %} aria-current="page"{% endif %}>{{ 'demo.nav.chat'|trans }}</a>
                <span class="nowo-ui-muted">{{ app.user.userIdentifier }}</span>
                <a class="nowo-ui-link" href="{{ path('demo_logout') }}">{{ 'demo.logout'|trans }}</a>
            {% else %}
                <a class="nowo-ui-link" href="{{ path('demo_login', { _locale: app.request.locale }) }}"{% if _route == 'demo_login' %} aria-current="page"{% endif %}>{{ 'demo.login.nav'|trans }}</a>
            {% endif %}
            <a class="nowo-ui-link" href="{{ path(locale_route, locale_params|merge({ _locale: 'en' })) }}" hreflang="en" lang="en"{% if app.request.locale == 'en' %} aria-current="true"{% endif %}>EN</a>
            <a class="nowo-ui-link" href="{{ path(locale_route, locale_params|merge({ _locale: 'es' })) }}" hreflang="es" lang="es"{% if app.request.locale == 'es' %} aria-current="true"{% endif %}>ES</a>
        </nav>
        <div class="nowo-ui-header__end">
            {{ include('@NowoUiKitBundle/partials/_theme_toggle.html.twig', { compact: true }, false) }}
        </div>
    </header>
{% endblock %}

{% block nowo_ui_modals %}
    {{ parent() }}
    {# The floating chat dock: renders nothing for guests. #}
    {{ include('@NowoChatKitBundle/dock.html.twig') }}
{% endblock %}

{% block nowo_ui_scripts %}
    {{ parent() }}
    {{ vite_entry_script_tags('app') }}
{% endblock %}
