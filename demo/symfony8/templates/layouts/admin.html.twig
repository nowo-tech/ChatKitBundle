{#
  Demo host layout on the UiKit contract (nowo_ui_kit.layouts.admin): UiKit document + admin regions, the demo navbar
  in nowo_ui_navigation, Bootstrap + Vite loaded by the demo (never by the bundle), the chat dock in nowo_ui_modals.
  The full-page chat (/chat/) renders here with web_ui.layout_template left null.
#}
{% extends '@NowoUiKit/layout/admin.html.twig' %}

{% block nowo_ui_styles %}
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('demo.css') }}">
    {{ vite_entry_link_tags('app') }}
{% endblock %}

{% block nowo_ui_navigation %}
    {% set locale_route = app.request.attributes.get('_route') %}
    {% set locale_params = app.request.attributes.get('_route_params')|default({}) %}
    {% set locale_route = locale_route starts with 'nowo_chat_' ? 'homepage' : locale_route %}
    {% set locale_params = locale_route == 'homepage' ? {} : locale_params %}
    <nav class="navbar navbar-expand-lg navbar-dark demo-navbar">
        <div class="container">
            <a class="navbar-brand" href="{{ path('homepage', { _locale: app.request.locale }) }}">{{ 'demo.brand'|trans }}</a>
            <div class="navbar-nav me-auto">
                <a class="nav-link{{ app.request.attributes.get('_route') == 'homepage' ? ' active' }}" href="{{ path('homepage', { _locale: app.request.locale }) }}">{{ 'demo.nav.home'|trans }}</a>
                {% if app.user %}
                    <a class="nav-link{{ app.request.attributes.get('_route') starts with 'nowo_chat_page' ? ' active' }}" href="{{ path('nowo_chat_page') }}">{{ 'demo.nav.chat'|trans }}</a>
                {% endif %}
            </div>
            <div class="navbar-nav ms-auto align-items-lg-center gap-lg-2">
                {% if app.user %}
                    <span class="navbar-text text-white-50 small">{{ app.user.userIdentifier }}</span>
                    <a class="nav-link text-white" href="{{ path('demo_logout') }}">{{ 'demo.logout'|trans }}</a>
                {% else %}
                    <a class="nav-link text-white" href="{{ path('demo_login', { _locale: app.request.locale }) }}">{{ 'demo.login.nav'|trans }}</a>
                {% endif %}
                <div class="nav-item dropdown">
                    <a class="nav-link dropdown-toggle text-white" href="#" id="localeDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                        {{ 'demo.language'|trans }} ({{ app.request.locale|upper }})
                    </a>
                    <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="localeDropdown">
                        <li><a class="dropdown-item {{ app.request.locale == 'en' ? 'active' : '' }}" href="{{ path(locale_route, locale_params|merge({ _locale: 'en' })) }}">English</a></li>
                        <li><a class="dropdown-item {{ app.request.locale == 'es' ? 'active' : '' }}" href="{{ path(locale_route, locale_params|merge({ _locale: 'es' })) }}">Español</a></li>
                    </ul>
                </div>
            </div>
        </div>
    </nav>
{% endblock %}

{% block nowo_ui_modals %}
    {{ parent() }}
    {# The floating chat dock: renders nothing for guests. #}
    {{ include('@NowoChatKitBundle/dock.html.twig') }}
{% endblock %}

{% block nowo_ui_scripts %}
    {{ parent() }}
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    {{ vite_entry_script_tags('app') }}
{% endblock %}
