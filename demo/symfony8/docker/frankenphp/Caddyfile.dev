# REQ-RUNTIME-001: timeout hierarchy, innermost first —
#   HttpClient 5s (framework.http_client) < PHP max_execution_time 30s (docker/php-dev.ini)
#   < Caddy servers.timeouts.write 60s (below). FrankenPHP max_wait_time 30s caps how long a
#   request waits for a free PHP thread (504 instead of an endless queue).
{
	order mercure after encode
	skip_install_trust
	frankenphp {
		max_wait_time 30s
	}
	servers {
		timeouts {
			write 60s
		}
	}
}

:80 {
	root * /app/public
	encode zstd br gzip
	# Disable cache in development so changes are reflected immediately
	header Cache-Control "no-store, no-cache, must-revalidate, max-age=0"
	header Pragma "no-cache"
	# Classic mode (no worker): each request runs in a new PHP process so the app always responds and file changes are visible
	mercure {
		anonymous
	}

	# Built Pentatrion Vite assets (pnpm run build).
	handle /build/* {
		file_server
	}

	php_server {
		hot_reload
	}
}
