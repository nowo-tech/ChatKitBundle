{#
 # Deprecated since 1.5 (removed in 2.0): the 1.x default layout of page_legacy.html.twig (Twig global
 # `nowo_chat_kit_page_layout`). The 1.5 page renders in the UiKit layout (`web_ui.layout_template`, null =
 # nowo_ui_kit.layouts.admin). 1.x: set `page_layout` to your own:
 # it must define the `title`, `stylesheets`, `javascripts` and `body` blocks (page.html.twig appends the chat
 # stylesheet and script to the first two with parent()).
 #}
<!doctype html>
<html lang="{{ app.request.locale|default('en') }}">
    <head>
        <meta charset="utf-8">
        <meta name="viewport" content="width=device-width, initial-scale=1">
        <title>{% block title %}{% endblock %}</title>
        {% block stylesheets %}{% endblock %}
        {% block javascripts %}{% endblock %}
    </head>
    <body>
        {% block body %}{% endblock %}
    </body>
</html>
