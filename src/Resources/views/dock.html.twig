{#
 # NowoChatKitBundle floating dock. Include it once in the base layout of signed-in pages:
 #
 #     {{ include('@NowoChatKitBundle/dock.html.twig') }}
 #
 # Guests and unreachable accounts get nothing. The markup the dock script works on lives in
 # `_templates.html.twig` (<template> elements); to change part of it, create
 # templates/bundles/NowoChatKitBundle/_templates.html.twig with
 # {% extends '@!NowoChatKitBundle/_templates.html.twig' %} and redefine the blocks you need.
 #}
{% set nowo_chat_config = nowo_chat_dock_config() %}
{% if nowo_chat_config %}
    {% block nowo_chat_assets %}
        {# The full-page chat (page.html.twig) already loads them in the layout head. #}
        {% if not (nowo_chat_page_assets ?? false) %}
            <link rel="stylesheet" href="{{ asset('css/nowo-chat.css', 'nowo_chat_kit') }}">
            <script src="{{ asset('js/nowo-chat.js', 'nowo_chat_kit') }}" defer></script>
        {% endif %}
    {% endblock %}
    {% block nowo_chat_root %}
        <div class="nowo-chat" data-nowo-chat-config="{{ nowo_chat_config|json_encode|e('html_attr') }}" data-testid="chat-dock">
            {{ include('@NowoChatKitBundle/_templates.html.twig', {nowo_chat_locale: nowo_chat_config.locale}) }}
        </div>
    {% endblock %}
{% endif %}
